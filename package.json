{
  "name": "vibe-code-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepare": "husky install",
    "i18n:sync": "node scripts/i18n-sync.cjs",
    "i18n:watch": "chokidar \"src/**/*.{ts,tsx,js,jsx}\" -i \"src/**/*.d.ts\" -i \"locales/**\" -i \"node_modules/**\" -i \".next/**\" -c \"node scripts/i18n-sync.cjs\"",
    "dx": "concurrently -k -n dev,i18n -c blue,magenta \"bun run dev\" \"bun run i18n:watch\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.553.0",
    "next": "^16.1.6",
    "next-intl": "^4.5.0",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.19",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome format --write",
      "biome check --write"
    ]
  },
  "engines": {
    "bun": ">=1.3.0",
    "npm": "use-bun-instead"
  }
}
